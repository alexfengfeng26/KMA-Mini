KMA_PORT=8090
KMA_DB_URL=jdbc:postgresql://localhost:5432/kma_mini
KMA_DB_USERNAME=kma
KMA_DB_PASSWORD=change-me
KMA_AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
# 平台 CI 发布门户扩展包时使用的 HMAC 密钥；不要提交真实值或在设计中心展示。
# KMA_PORTAL_EXTENSION_SIGNING_KEY=replace-with-a-platform-ci-only-secret
# 生产建议将沙箱部署到独立来源；APP_ORIGIN 仅允许 https:// 或本机 http:// 地址
# KMA_PORTAL_SANDBOX_ORIGIN=https://sandbox-kma.example.com
# KMA_PORTAL_APP_ORIGIN=https://kma.example.com
KMA_IDEMPOTENCY_TTL_HOURS=24
KMA_IDEMPOTENCY_LEASE_SECONDS=300
KMA_BOOTSTRAP_ADMIN_USERNAME=admin
KMA_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

KMA_CONTENT_SECURITY_ENABLED=true
KMA_BLOCK_PROMPT_INJECTION=true
KMA_REDACT_BEFORE_MODEL=true
KMA_REDACT_MODEL_OUTPUT=true
KMA_CONTENT_SECURITY_AUDIT=true

KMA_EMBEDDING_PROVIDER=local-bge-m3
KMA_LOCAL_EMBEDDING_BASE_URL=http://localhost:9997/v1
KMA_LOCAL_EMBEDDING_MODEL=bge-m3

# 知识问答优先使用数据库中激活的 LLM Profile；以下仅为无 Profile 时的兼容回退。
KMA_LLM_PROVIDER=deepseek
KMA_LLM_BASE_URL=https://api.deepseek.com
KMA_LLM_MODEL=deepseek-v4-flash
KMA_LOCAL_LLM_BASE_URL=http://localhost:11434/v1
KMA_LOCAL_LLM_MODEL=qwen2.5
KMA_LOCAL_LLM_API_KEY=ollama

# 模型 Profile 只保存下列环境变量名，绝不保存 API Key 原文。按实际启用的供应商填写。
KMA_DEEPSEEK_API_KEY=
KMA_KIMI_API_KEY=
KMA_ZHIPU_API_KEY=
KMA_DASHSCOPE_API_KEY=
KMA_MINIMAX_API_KEY=

# 门户 AI 设计专用 DeepSeek V4 Flash；真实密钥只放在进程环境中。
KMA_PORTAL_AI_ENABLED=true
KMA_PORTAL_AI_BASE_URL=https://api.deepseek.com
KMA_PORTAL_AI_MODEL=deepseek-v4-flash
KMA_PORTAL_AI_TIMEOUT_SECONDS=90

# Optional local Theme V4 mother packages.  When the directory exists, the design center reads
# it before the classpath copy; keep this path outside source control only for private themes.
KMA_PORTAL_THEME_SOURCE_DIR=src/main/resources/portal-themes

KMA_INGESTION_WORKER_ENABLED=false
# 默认跟随 KMA_INGESTION_WORKER_ENABLED，也可单独设置
# KMA_EMBEDDING_REBUILD_WORKER_ENABLED=false
KMA_FEED_ENABLED=false
KMA_GOVERNANCE_ENABLED=false

# Linux 生产可切换为 MinIO/S3 兼容存储；凭据只通过环境变量注入
KMA_STORAGE_TYPE=local
KMA_STORAGE_PATH=upload/knowledge
# KMA_STORAGE_ENDPOINT=https://minio.example.com
# KMA_STORAGE_ACCESS_KEY=replace-me
# KMA_STORAGE_SECRET_KEY=replace-me
# KMA_STORAGE_BUCKET=kma-documents

# 可选本地 OCR 兼容接口：POST JSON {contentBase64,mimeType} -> {text}
KMA_OCR_ENABLED=false
KMA_OCR_BASE_URL=http://localhost:8866

# Portal Theme V4 使用无同源权限的 sandbox iframe 与 connect-src 'none' CSP。
# 主题不能读取以下后端环境变量、访问令牌或核心应用源码。
# 前端模块/CMS/主题不读取后端环境变量：
# 部署全局 /config/kma-runtime.json，
# 品牌资源部署到同源 /themes/**。
