{
  "name": "kma-admin-web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "check": "npm run format:check && npm run lint && npm run stylelint && npm run typecheck",
    "typecheck": "vue-tsc -b",
    "lint": "eslint . --max-warnings=0",
    "stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"*.{ts,json}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bundle:check": "node ./scripts/check-bundle-budget.mjs",
    "quality": "npm run check && npm run test:coverage && npm run build && npm run bundle:check",
    "api:generate": "openapi-typescript ./openapi/kma-openapi.json -o ./src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@formkit/drag-and-drop": "^0.6.1",
    "@tanstack/vue-query": "^5.101.4",
    "ajv": "^8.17.1",
    "element-plus": "^2.10.4",
    "esprima": "^4.0.1",
    "monaco-editor": "^0.56.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.54.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.1"
  }
}
